{
  "appId": "com.twoplayer.games",
  "appName": "Игры для двоих",
  "webDir": "public",
  "ios": {
    "contentInset": "automatic",
    "scrollEnabled": false,
    "backgroundColor": "#16134a",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#16134a",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#16134a",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}

